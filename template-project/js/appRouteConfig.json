{
    "basePath": "modules",
    "defaultRoute": "dashboard",
    "contentContainer": "#content-area",
    "environmentSettings": {
        "default": {
            "SupabaseUrl": "YOUR_SUPABASE_URL",
            "LambdaProxyUrl": "YOUR_LAMBDA_PROXY_URL"
        },
        "dev": {
            "SupabaseUrl": "YOUR_DEV_SUPABASE_URL",
            "LambdaProxyUrl": "YOUR_DEV_LAMBDA_PROXY_URL"
        },
        "uat": {
            "SupabaseUrl": "YOUR_UAT_SUPABASE_URL",
            "LambdaProxyUrl": "YOUR_UAT_LAMBDA_PROXY_URL"
        },
        "prod": {
            "SupabaseUrl": "YOUR_PROD_SUPABASE_URL",
            "LambdaProxyUrl": "YOUR_PROD_LAMBDA_PROXY_URL"
        }
    },
    "appRoutes": {
        "dashboard": {
            "description": "Dashboard",
            "path": "dashboard",
            "html": "html/dashboard.html",
            "js": [
                "js/dashboard.js"
            ],
            "css": [
                "css/dashboard.css"
            ]
        },
        "example-module-grid": {
            "description": "Example Module Management",
            "path": "example-module",
            "html": "html/example-module_grid.html",
            "js": [
                "js/example-module_grid.js"
            ],
            "css": [
                "css/example-module_grid.css"
            ]
        }
    }
}

