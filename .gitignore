# IDE and editor files
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# Cursor: ignore local IDE data; track shared project rules only
.cursor/*
!.cursor/rules/
!.cursor/rules/**/*.mdc

# Debug logs
debug.log

# Node modules (if added later)
node_modules/

# Environment files
.env
.env.local
.env.e2e
Playwright Tests/.env.e2e

# Build artifacts
dist/
build/
*.log

# E2E test results (local artifacts only)
Playwright Tests/test-results/
Playwright Tests/playwright-report/
Playwright Tests/.last-run.json

# One-off MCP / batch execution artifacts (do not commit)
agent-tools/
scripts/_soh_batches/
.tmp-issues-stash/

nul

# Supabase CLI machine-local state (link target, cached versions)
supabase/.temp/

# Agent Fleet: Cursor plan drafts are local scratch - keep them off dev so a plan
# pushed to dev-agent is always a genuine new commit that runs. .cursor/rules/ stays tracked.
.cursor/plans/
# Claude Code: per-developer settings. Never tracked - it accretes one-off Bash
# allowlist entries that have previously embedded a live Supabase PAT.
.claude/settings.local.json
